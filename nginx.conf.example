# Reverse-proxy mode: when you prefer to terminate TLS with nginx, leave
# tls.cert/tls.key empty in config.yaml and proxy DoH + the API to the plain
# HTTP backend (config "http": "127.0.0.1:8080").
#
# The stream block below fronts :443 and attaches a PROXY protocol header with
# the real client address to every connection it forwards (proxy_protocol on).
# Destinations that want that address parse it themselves: Kairo's SNI router
# for the tunnel gate and the nginx HTTP server below for DoH/API. Backends
# that expect plain TCP get the header stripped by the internal hop.
# Kairo config for this: "listen.https": "127.0.0.1:8447", "proxy_protocol": true.
#
# Do NOT route through an extra nginx hop that re-emits the header: nginx only
# re-emits the address it parsed from a PROXY header if the stream realip
# module rewrites $remote_addr, otherwise the re-emitted header carries the
# hop's own loopback address and Kairo sees every client as allowed.

stream {
    # Known hostnames go to the strip hop; the DNS hostname and unknown SNIs
    # (the restricted domains) go to destinations that parse the header.
    map $ssl_preread_server_name $backend {
        dns.example.com            127.0.0.1:8443;  # nginx HTTP server below
        # net.example.com          127.0.0.1:9443;  # strip hop for other services
        default                    127.0.0.1:8447;  # unknown SNI -> Kairo tunnel
    }

    # Backends that expect plain TCP get the header stripped here.
    map $ssl_preread_server_name $known_backend {
        net.example.com            127.0.0.1:8444;
        default                    127.0.0.1:8444;
    }

    # Public listener: attaches the header with the real client address.
    server {
        listen 443;
        ssl_preread on;
        proxy_pass $backend;
        proxy_protocol on;
    }

    # Strip hop: parses the header, then forwards plain TCP to the real
    # backends, so they keep seeing normal connections.
    server {
        listen 127.0.0.1:9443 proxy_protocol;
        ssl_preread on;
        proxy_pass $known_backend;
    }
}

# nginx terminates TLS for Kairo's own hostname and proxies DoH + the API to
# the loopback HTTP backend. The listener parses the PROXY header so the real
# client IP flows through X-Forwarded-For, which Kairo trusts because the
# direct peer is loopback.
http {
    server {
        listen 8443 ssl http2 proxy_protocol;
        set_real_ip_from 127.0.0.1;
        real_ip_header proxy_protocol;
        server_name dns.example.com;

        ssl_certificate     /etc/letsencrypt/live/dns.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/dns.example.com/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location /dns-query {
            proxy_pass http://127.0.0.1:8080/dns-query;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8080/api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /healthz {
            proxy_pass http://127.0.0.1:8080/healthz;
            proxy_set_header Host $host;
        }

        location / {
            proxy_pass http://127.0.0.1:8080/;
            proxy_set_header Host $host;
        }
    }
}
