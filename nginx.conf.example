# Reverse-proxy mode: when you prefer to terminate TLS with nginx/caddy, leave
# tls.cert/tls.key empty in config.json, point "host_backend" at this server
# (e.g. "127.0.0.1:8443"), and proxy DoH + the API to the plain HTTP backend
# (config "http": "127.0.0.1:8080").
#
# The SNI router forwards https://dns.example.com traffic to this 8443 listener,
# so DoH stays available at https://dns.example.com/dns-query.

server {
    listen 8443 ssl http2;
    server_name dns.example.com;

    ssl_certificate     /etc/letsencrypt/live/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dns.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location /dns-query {
        proxy_pass http://127.0.0.1:8080/dns-query;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /healthz {
        proxy_pass http://127.0.0.1:8080/healthz;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
    }
}
