# Kairo configuration — a single YAML file for runtime settings.
# Copy this to config.yaml, fill in your values, then run: kairo run
#
# The routing policy lives under data_dir:
#   domains.txt   - restricted domains (subdomains covered automatically)
#   domain.txt    - ip_source domains the allowlist generator resolves
# Client IPs are stored in the database (kairo.db) and managed from the web
# panel or the API (/api/allow). A leftover allowed.txt from 0.2.x is imported
# into the admin account once on startup and renamed to allowed.txt.legacy.

# Public hostname for DoH and the API (matched via SNI).
host: dns.example.com

# Public URLs for admin panel and DoH. If empty, derived from host as
# https://<host>/ and https://<host>/dns-query. Set explicitly if behind
# a reverse proxy or custom domain.
admin_url: https://dns.example.com/
doh_url: https://dns.example.com/dns-query

# Where host SNI goes when we are NOT terminating TLS. Leave empty to have
# Kairo terminate TLS itself with the ACME-managed certificate.
host_backend: ""

# Public IP of this box, handed out for restricted domains.
vps_ip: 1.2.3.4

# Shared secret for /api/*. Keep it long and ugly.
api_key: REPLACE_WITH_A_STRONG_SECRET

# Admin password for web UI login. Defaults to api_key when empty.
admin_password: ""

# Path to the built frontend files (served as static files).
web_dir: ./web/dist

# Session lifetime in hours (default: 24).
session_ttl: 24

# Upstream DNS resolvers.
upstream_dns:
  - 1.1.1.1:53
  - 8.8.8.8:53

listen:
  dns: ":53"
  dot: ":853"
  https: ":443"            # the SNI router: DoH, API and the tunnel
  http: "127.0.0.1:8080"   # loopback backend for reverse proxies
  metrics: "127.0.0.1:9090" # Prometheus endpoint (loopback-only, not exposed publicly)

# Automatic certificate management via Let's Encrypt (http-01 challenge) using
# github.com/go-acme/lego. Set email to enable it: a certificate for `host` is
# obtained automatically on first run and renewed before it expires. The
# http-01 challenge must be reachable on port 80, so make sure :80 is open and
# forwarded to this machine, and that `host` resolves to vps_ip.
acme:
  email: ""                       # your email for the ACME account
  storage: ""                     # dir for account key + cert (default: <data_dir>/certs, persisted under /data in Docker)
  directory: ""                   # ACME directory (empty = Let's Encrypt production)
  renew_before_days: 30           # renew when the cert expires within this many days
  http_listen: ":80"              # where the http-01 challenge is served

# Static certificate, for hand-managed certs. Used only when acme.email is
# empty; configuring both acme.email and tls is an error and the server refuses
# to start.
tls:
  cert: /etc/letsencrypt/live/dns.example.com/fullchain.pem
  key: /etc/letsencrypt/live/dns.example.com/privkey.pem

# Directory holding the policy text files.
data_dir: data

# TTL for the fake A records handed out to allowlisted clients.
ttl: 300

# Global per-second limits for DNS and API.
rate:
  dns: 200
  dns_burst: 400
  api: 20
  api_burst: 40

# Trust the client address in a PROXY protocol v1 header, but only from
# loopback peers (a local nginx fronting :443).
proxy_protocol: false

# Allowlist generator: resolve the domains in `domains_file`, allowlist the
# results, repeat every `interval` seconds (0 disables the background job).
# Run "kairo gen-ips" after editing the file.
ip_source:
  domains_file: domain.txt
  interval: 300
